        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Massedurchsatz [dik]</rdfs:label>
        <rdfs:label xml:lang="en">mass throughput [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000439">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Pressure variation refers to the change in pressure within a fluid as a function of depth, position, and time, influenced by factors such as fluid density and gravitational force.</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
