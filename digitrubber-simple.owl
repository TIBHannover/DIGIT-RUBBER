        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Druckschwankung [dik]</rdfs:label>
        <rdfs:label xml:lang="en">pressure variation [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000440 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000440">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Geometry variation refers to the distortion and rearrangement of polymer chains due to various factors such as temperature, pressure and external forces that can lead to changes in the polymer&apos;s physical properties such as viscosity, strength and flexibility.</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Geometrieschwankung [dik]</rdfs:label>
        <rdfs:label xml:lang="en">geometry variation [dik]</rdfs:label>
    </owl:Class>
    


