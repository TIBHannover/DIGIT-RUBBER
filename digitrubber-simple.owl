    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000424 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000424">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Maschine, die mit Hilfe einer Schnecke oder einer hydraulischen Presse kontinuierlich ein Material formt, indem dieses durch eine oder mehrere Schablonen gepresst wird</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">machine which, through the use of a screw or a hydraulic ram, continuously shapes a material by forcing it through a die or dies</obo:IAO_0000115>
        <obo:coarseClassification>device</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Extruder</rdfs:label>
        <rdfs:label xml:lang="en">extruder</rdfs:label>
    </owl:Class>
    


