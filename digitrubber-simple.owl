        <rdfs:label xml:lang="de">Werkzeugzonen-Temperatur [dik]</rdfs:label>
        <rdfs:label xml:lang="en">molding zone temperature [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000474">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">04.05.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Vulkanisationszeit [dik]</rdfs:label>
        <rdfs:label xml:lang="en">vulcanization time [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000475 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000475">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Anzahl von Vernetzungen in einem Vulkanisat je Volumen- oder Masseneinheit</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">number of crosslinks per unit volume or unit mass of vulcanizate</obo:IAO_0000115>
        <obo:coarseClassification>quality</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Vernetzungsdichte [dik]</rdfs:label>
        <rdfs:label xml:lang="en">crosslink density [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000476 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000476">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Produkt der Vulkanisation einer Kautschukmischung</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">product of the vulcanization of a rubber compound</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">vulcanized rubber</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="de">vulkanisierter Kautschuk</obo:IAO_0000118>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Vulkanisat [dik]</rdfs:label>
        <rdfs:label xml:lang="en">vulcanizate [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000477">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">chemical bond or atom(s) joining two rubber chains or two parts of the same rubber chain as a result of vulcanization</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">chemische Bindung oder Atom(e), die zwei Kautschukketten oder zwei Teile derselben Kette verbinden als Ergebnis der Vulkanisation</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">In a vulcanizate, trapped chain entanglements can act as physical crosslinks and contribute to the crosslink density.</rdfs:comment>
        <rdfs:comment xml:lang="de">In einem Vulkanisat können eingeschlossene Verschlaufungen als physikalische Vernetzungen fungieren und einen Beitrag zur Vernetzungsdichte leisten.</rdfs:comment>
        <rdfs:label xml:lang="de">Vernetzung [dik]</rdfs:label>
        <rdfs:label xml:lang="en">crosslink [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000479">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">〈Aktion〉 Erzeugung von Vernetzungen zwischen oder innerhalb von Kautschukketten unter Ausbildung eines Netzwerks</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">〈act of〉 insertion of crosslinks between or within rubber chains to give a network structure</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">04.05.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Vernetzen [dik]</rdfs:label>
        <rdfs:label xml:lang="en">crosslinking [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000480 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000480">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Zustand eines Vulkanisats während des Vulkanisationsverlaufs, gemessen an dessen Struktur oder dessen Eigenschaften</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">condition of a vulcanizate during the course of vulcanization, measured in terms of its structure or properties</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Vernetzungsgrad [dik]</rdfs:label>
        <rdfs:label xml:lang="en">state of cure [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000481">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Verfahren, üblicherweise auf Hitze basierend, bei dem Kautschuk durch eine Veränderung seiner chemischen Struktur (zum Beispiel Vernetzung) in einen Zustand überführt wird, in dem die elastischen Eigenschaften erzeugt, wiederhergestellt oder verbessert oder über einen größeren Tempe-raturbereich erweitert werden</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">process, usually involving heat, in which rubber, through a change in its chemical structure (for example, crosslinking), is converted to a condition in which the elastic properties are conferred or re-established or improved or extended over a greater range of temperatures</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Vernetzung</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">cure</obo:IAO_0000118>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Vulkanisation [dik]</rdfs:label>
        <rdfs:label xml:lang="en">vulcanization [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000482">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Druckkessel, der zur Vulkanisation von Kautschuk in Dampf oder Gas genutzt wird</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">pressurized vessel used for vulcanizing rubber in a vapour or gas</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Autoklav [dik]</rdfs:label>
        <rdfs:label xml:lang="en">autoclave [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000485 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000485">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Art der Vulkanisation, bei der das Modul des Vulkanisats ein Maximum erreicht und dann über einen längeren Zeiraum bei der entsprechenden Vulkanisationstemperatur nahezu konstant bleibt</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">type of vulcanization during which the modulus of the vulcanizate proceeds to a maximum and then remains essentially constant for a substantial period at the vulcanization temperature</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Vulkanisationsebene</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">flat cure</obo:IAO_0000118>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Vulkanisationsplateau [dik]</rdfs:label>
        <rdfs:label xml:lang="en">plateau cure [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000486">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Vulkanisationsbedingungen, die notwendig sind, um einen akzeptablen Kompromiss zwischen verschiedenen gewünschten Vulkanisateigenschaften zu erzielen bzw. den optimalen Wert für eine bestimmte Eigenschaft zu erhalten</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">condition of vulcanization required to achieve an acceptable compromise among a number of desired vulcanizate properties or the optimum value of a selected property</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Vulkanisationsoptimum [dik]</rdfs:label>
        <rdfs:label xml:lang="en">optimum cure [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000487">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Vulkanisationszustand jenseits des Vulkanisationsoptimums</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">state of vulcanization beyond the optimum cure</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Overcure is generally caused by too long a time and/or too high a temperature of vulcanization and/or post cure, and/or a surplus of vulcanizing agents.</rdfs:comment>
        <rdfs:comment xml:lang="de">Übervulkanisation wird gewöhnlich hervorgerufen durch zu lange Heizzeit und/oder zu hohe Vulkanisations- und/oder Nachvulkanisationstemperatur und/oder ein Übermaß an Vulkanisationsmitteln.</rdfs:comment>
        <rdfs:label xml:lang="en">overcure [dik]</rdfs:label>
        <rdfs:label xml:lang="de">Übervulkanisation [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000488">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Zustand der Vulkanisation unterhalb des Vulkanisationsoptimums</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">state of vulcanization less than the optimum cure</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Undercure is generally caused by too short a time and/or too low a temperature of vulcanization and/or post cure, and/or a deficiency of vulcanizing agents.</rdfs:comment>
        <rdfs:comment xml:lang="de">Untervulkanisation wird im Allgemeinen durch zu kurze Zeit und/oder zu niedrige Vulkanisationstemperatur und/oder Nachvulkanisation und/oder Mängel der Vulkanisationsmittel hervorgerufen.</rdfs:comment>
        <rdfs:label xml:lang="de">Untervulkanisation [dik]</rdfs:label>
        <rdfs:label xml:lang="en">undercure [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000489 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000489">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">ein oder mehrere Teile, entnommen aus einem Los, um Informationen über dieses Los zu liefern und möglicherweise als Entscheidungsbasis über das Los oder seinen Herstellprozess zu dienen</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">one or more items taken from a lot and intended to provide information on the lot and possibly to serve as a basis for a decision on the lot or on the process which had produced it</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Probe [dik]</rdfs:label>
        <rdfs:label xml:lang="en">sample [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000492 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000492">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Körper eines Materials von geeigneter Form und Dimension, fertig vorbereitet zur Verwendung in einer Prüfung</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">piece of material of appropriate shape and size, prepared so that it is ready for use in a test</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Probekörper</obo:IAO_0000118>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:comment xml:lang="de">Die englischen Benennungen „test specimen“ und „specimen“ werden häufig verwendet, um einen „Prüfkörper“ zu bezeichnen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The terms “test specimen” and “specimen” are also widely used to denote “test piece”.</rdfs:comment>
        <rdfs:label xml:lang="de">Prüfkörper [dik]</rdfs:label>
        <rdfs:label xml:lang="en">test piece [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000493">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">raw, compounded, vulcanized or partially vulcanized rubber in the form of end-of-life rubber products or factory scrap</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">unverarbeiteter, gemischter, vulkanisierter oder teilvulkanisierter Kautschuk in Form von Altgummierzeugnissen oder Fabrikabfall</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Gummiabfall [dik]</rdfs:label>
        <rdfs:label xml:lang="en">scrap rubber [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000494 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000494">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">raw, compounded, vulcanized or partially vulcanized rubber rejected or generated as waste during product manufacture and found unsuitable for further use unless recycled</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">roher, gemischter, vulkanisierter oder teilweise vulkanisierter Kautschuk, der bei der Produktion ver-worfen oder als Abfall deklariert und für die weitere Verwendung, außer zum Recyceln, als ungeeignet befunden wird</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Produktionsabfall [dik]</rdfs:label>
