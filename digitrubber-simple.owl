    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000563">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Die Ölabsorptionszahl eines Rußes steht im Zusammenhang mit den Verarbeitungs- und Vulkanisationseigenschaften von Kautschukmischungen die den Ruß enthalten</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">The oil absorption number of a carbon black is related to the processing and vulcanizate properties of rubber compounds containing the carbon black</obo:IAO_0000115>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>ASTM D2414-12</terms:identifier>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">oil absorption number [dik]</rdfs:label>
        <rdfs:label xml:lang="de">Ölabsorptionszahl [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000565">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The ratio of the dynamic viscosity (μ) over the density of the fluid (ρ), which is noted as (length)^2/time. https://en.wikipedia.org/wiki/Viscosity#Kinematic_viscosity</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/UO_01200023"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn>25.08.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">25.08.2022</oboInOwl:creation_date>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label xml:lang="de">Kinematische Viskosität [uo]</rdfs:label>
        <rdfs:label xml:lang="en">kinematic viscosity [uo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000566 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000566">
