    <!-- http://purl.obolibrary.org/obo/RO_0002430 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002430">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002428"/>
