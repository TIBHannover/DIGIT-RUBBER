    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000435 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000435">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Unterschied zwischen den Dimensionen des Profilquerschnittes eines Extrudats und den korrespondierenden Dimensionen des Auslaufkanals, welcher üblicherweise als prozentuelle Zunahme der Fläche des Querschnittes ausgedrückt wird</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">difference between the dimensions of the cross-section of an extrudate and the corresponding dimensions of the die orifice, usually quantified as the percentage increase in the crosssectional area</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
