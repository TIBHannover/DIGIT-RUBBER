    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000572">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Verhältnis von Schubspannung zu Scherdehnung, wobei jede durch eine komplexe Zahl dargestellt werden kann</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">ratio of the shear stress to the shear strain, where each can be represented by a complex number</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>G*</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">complex shear modulus [dik]</rdfs:label>
        <rdfs:label xml:lang="de">komplexer Schubmodul [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000573 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000573">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Verhältnis von Normalspannung zur Belastung, wobei jede durch eine komplexe Zahl dargestellt werden kann</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">ratio of the normal stress to the normal strain, where each can be represented by a complex number</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>E*</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">complex Young’s modulus [dik]</rdfs:label>
        <rdfs:label xml:lang="de">komplexer Young’s Modul [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000574">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">die Komponente einer aufgebrachten Schubspannung, welche in Phase mit der Scherdeformation ist, geteilt durch die Dehnung</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">that component of an applied shear stress which is in phase with the shear strain, divided by the strain</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Schermodul</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">storage shear modulus</obo:IAO_0000118>
        <obo:coarseClassification>quality</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>G&apos;</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="de">Elastizitätsmodul [dik]</rdfs:label>
        <rdfs:label xml:lang="en">elastic shear modulus [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000575 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000575">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">die Komponente einer angewandten Normalspannung, welche in Phase mit der Normaldehnung ist, geteilt durch die Dehnung</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">that component of an applied normal stress which is in phase with the normal strain, divided by the strain</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Youngscher Speichermodul</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">storage Young’s modulus</obo:IAO_0000118>
        <obo:coarseClassification>quality</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>E&apos;</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="de">Youngscher Elastizitätsmodul [dik]</rdfs:label>
        <rdfs:label xml:lang="en">elastic Young’s modulus [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000576">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">der Anteil einer aufgebrachten Schubspannung, welche 90° phasenverschoben gegenüber der Scherdeformation ist, geteilt durch die Dehnung</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">that component of an applied shear stress which is in quadrature (90° out of phase) with the shear strain, divided by the strain</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
