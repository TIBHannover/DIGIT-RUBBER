    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000427">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A cylindrical or rod-shaped material object located in the pin zone of an extruder that enhances shearing and homogenization of polymer material.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">shearing pin</obo:IAO_0000118>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8280-0487"/>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn>24.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">21.05.2022</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Pins improve material homogenization and facilitate polymer transport within the extruder.</rdfs:comment>
        <rdfs:label xml:lang="de">Extruderstift</rdfs:label>
        <rdfs:label xml:lang="en">extruder pin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000428">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">rotating member with one or more helical grooves, used to propel rubber along the barrel of an extruder</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">rotierendes Glied mit einer oder mehreren helixförmigen Rillen, das verwendet wird, um einen Kautschuk innerhalb eines Extruderrohrs voranzutreiben</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
