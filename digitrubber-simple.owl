                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000424"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">An extruder zone in which raw polymer material is introduced into the extruder for subsequent processing.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">feed zone</obo:IAO_0000118>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8280-0487"/>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn>24.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">21.05.2022</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Typically the first section of an extruder barrel, where raw compound is fed before melting or mixing.</rdfs:comment>
        <rdfs:label xml:lang="de">Einzugszone</rdfs:label>
        <rdfs:label xml:lang="en">feeding zone</rdfs:label>
    </owl:Class>
    


