        <oboInOwl:hasExactSynonym>G&apos;&apos;</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="de">Verlustmodul [dik]</rdfs:label>
        <rdfs:label xml:lang="en">loss shear modulus [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000577">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">der Anteil einer aufgebrachten Normalspannung, welcher 90° phasenverschoben gegenüber der Normaldehnung ist, geteilt durch die Dehnung</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">that component of an applied normal stress which is in quadrature (90° out of phase) with the normal strain, divided by the strain</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
