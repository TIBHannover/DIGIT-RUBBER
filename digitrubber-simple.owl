        <rdfs:label xml:lang="de">Kautschukextruderschnecke [dik]</rdfs:label>
        <rdfs:label xml:lang="en">rubber extruder screw [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000429 -->

