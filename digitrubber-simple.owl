    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000438">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">In polymers, mass throughput is the mass of polymer material that passes through a processing unit (e.g., extruder, mixer, or die) per unit time.</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
