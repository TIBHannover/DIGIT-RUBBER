    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000561 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000561">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
