        <rdfs:label xml:lang="de">Elastomere</rdfs:label>
        <rdfs:label xml:lang="en">elastomer [ita]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000047">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000003"/>
        <obo:DIGITRUBBER_72a5f0d7_2892_45ff_9e35_1440616c382b rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:DIGITRUBBER_72a5f0d7_2892_45ff_9e35_1440616c382b>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Industry 4.0 is the intelligent networking of machines and processes in the industrial environment, with the help of information and communication technology and thus digitization of the industrial production.</obo:IAO_0000115>
        <obo:coarseClassification>plan specification</obo:coarseClassification>
