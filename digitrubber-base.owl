    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A cylindrical or rod-shaped material object located in the pin zone of an extruder that enhances shearing and homogenization of polymer material.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">shearing pin</obo:IAO_0000118>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8280-0487"/>
