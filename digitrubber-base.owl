        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">18.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">gel permeation chromatography method [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Ratio of Mw to Mn</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">MWD</obo:IAO_0000118>
