        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Menge in Gramm an adsorbiertem Iod pro Kilogramm Ruß unter definierten Bedingungen</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">Number of grams of iodine adsorbed per kilogram of carbon black under specified conditions</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Jodzahl; Iodzahl</obo:IAO_0000118>
