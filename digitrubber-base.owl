        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28798"/>
        <obo:IAO_0000115 xml:lang="en">Any of several substances similar to natural rubber in properties and uses, produced synthetically. Constitutes an entity sub-group of the raw material entity.</obo:IAO_0000115>
        <obo:coarseClassification>material entity</obo:coarseClassification>
