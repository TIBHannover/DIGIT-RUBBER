    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000069">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0060008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A mixing recipe is a recipe which in polymers refers to the specific, controlled formulation and set of operating parameters—including ingredient proportions, sequence of addition, temperature profiles, shear rates, and mixing time—used to combine base polymers with additives, fillers, or other polymers to achieve a uniform, homogeneous mixture with desired physical and chemical properties.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">mixing recipe</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Objective specification set refers to the set of objectives which are the desired characteristics which are to be achieved at the end of a manufacturing process.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">objective specification set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000071 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000071">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0060007"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">An ingredient specification is a material specification which is detailed, actionable document defining the quality, safety, and physical characteristics of a raw material</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">ingredient specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000072">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0060007"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Ingredient Specification Set is the set of criteria or standards about ingredients to be used in the manufacturing process to attain certain quality or consistency of the end product.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">ingredient specification set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Device specifications, often referred to as &quot;tech specs,&quot; are detailed descriptions of the technical features and capabilities of a device, including hardware and software components.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">device specification set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Instruction set is the detailed information about how something should be done or operated.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">instruction set</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Instruction step is the method of following one instruction at a time in a process to achieve an end objective.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">instruction step</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A condition specification of a process definition refers to the detailed requirements and constraints that must be met within a process to ensure consistency and quality outlining necessary inputs, outputs, parameters that must be controlled to acheive desired outcomes.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">condition specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000077">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0060006"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The ram position in polymer mixing refers to the location of the ram within the mixing chamber which is crucial for maintaining the desired shear forces and ensuring uniform mixing of the polymer components.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">ram position</rdfs:label>
        <rdfs:label xml:lang="de">stempelweg</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000078">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">temperature of the compound</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">compound temperature</rdfs:label>
        <rdfs:label xml:lang="de">compoundtemperatur</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000079">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Shear rate in polymer mixing is defined as the rate of change of velocity of a fluid or material with respect to the distance between two parallel planes and it is a critical parameter that influences the flow behavior, viscosity, and morphology of polymer melts.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Schergeschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="en">shear rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000080 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000080">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Storage modulus (G′) is the component of the complex shear modulus that represents the stored elastic energy in a material during cyclic deformation.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Speichermodul</rdfs:label>
        <rdfs:label xml:lang="en">storage modulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">In the context of polymer mixing, symbolic regression is a method used to model the physical phenomena occurring during the processing of polymer materials.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">symbolic regression</rdfs:label>
        <rdfs:label xml:lang="de">symbolische regression</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000082">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The Savitzky–Golay (S–G) filter is a discrete system/filter used for time series smoothing, i.e. for removing higher-frequency components of time series.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">savtizky golay filter</rdfs:label>
        <rdfs:label xml:lang="en">savtizky golay filter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000083">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A Rubber Process Analyser (RPA) is a scientific instrument used to measure the rheological properties of rubber, particularly its viscoelastic behavior. It applies controlled shear stress and measures the resulting deformation or flow of the rubber.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">rubber process analyzer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The Payne effect is a phenomenon observed in filled rubbers, where the storage modulus decreases with increasing strain amplitude.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">payne effect</rdfs:label>
        <rdfs:label xml:lang="de">payne effekt</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Ring tests are analytical procedures involving the sequential addition of reagents to a sample, where the formation of a colored ring at the interface of the two liquids signals a positive result.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
