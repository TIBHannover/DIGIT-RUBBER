        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <rdfs:label xml:lang="en">agent [ncit]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000392"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Elastomers are dimensionally stable but elastically deformable plastics. They are producest by vulcanization of rubber.</obo:IAO_0000115>
        <obo:coarseClassification>material entity</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
