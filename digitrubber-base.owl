        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date>31.03.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">raw rubber samples [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000202">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000112>The concentration of Zinc in the extrudate is 0.5 g/L.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A quality of a substance in terms of its amount per unit volume in a mixture.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Konzentration</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Concentration</obo:IAO_0000119>
        <obo:coarseClassification>quality</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <obo:refersToCompetenceQuestion>IFNANO:01_CQ; IFNANO:02_CQ; IFNANO:03_CQ</obo:refersToCompetenceQuestion>
        <dc:contributor>Sven Schwabe (IFNANO)</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn>06.04.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">31.03.2022</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>conc.</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">concentration [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000205">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The quantity of a substance per unit volume or weight; a measure of the amount of substance present in a unit amount of mixture, particularly, the amount of solute dissolved in a solvent. The amounts can be expressed as moles, masses, volumes, or parts. (ncit defined)</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.obolibrary.org/obo/NCIT_C41185</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:coarseClassification>quality</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn>19.08.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">31.3.2022</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">http://purl.obolibrary.org/obo/ncit.owl</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <rdfs:label xml:lang="en">concentration [ncit]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000213">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000003"/>
        <obo:DIGITRUBBER_72a5f0d7_2892_45ff_9e35_1440616c382b rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:DIGITRUBBER_72a5f0d7_2892_45ff_9e35_1440616c382b>
        <obo:IAO_0000115 xml:lang="en">Laser induced breakdown spectroscopy is a type of atomic emission spectroscopy which uses a highly energetic laser pulse as the excitation source. The laser is focused to form a plasma, which atomizes and excites samples. The Emission of these excited species is analyzed to identify and quantify the elements contained in the sample.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Laserinduzierte Plasmaspektroskopie</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Laser-induced_breakdown_spectroscopy</obo:IAO_0000119>
        <obo:coarseClassification>plan specification</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <obo:refersToCompetenceQuestion>IFNANO:01_CQ; IFNANO:02_CQ; IFNANO:03_CQ</obo:refersToCompetenceQuestion>
        <dc:contributor>Sven Schwabe (IFNANO)</dc:contributor>
        <pav:lastUpdateOn>06.04.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">31.03.2022</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>LIBS</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">laser-induced breakdown spectroscopy [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000215">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000115 xml:lang="en">A quality of a sample in terms of homogenity, or the distribution of concentration of a specific component in a mixture, in a macroscopic body.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Verteilungsgüte; homogenity</obo:IAO_0000118>
        <obo:coarseClassification>quality</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <obo:refersToCompetenceQuestion>IFNANO:02_CQ; IFNANO:03_CQ</obo:refersToCompetenceQuestion>
        <dc:contributor>Sven Schwabe (IFNANO)</dc:contributor>
        <pav:lastUpdateOn>06.04.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">31.03.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">distribution quality [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">In Spectroscopy, peaks are features of a spectrum. A peak comprise a restricted region of a spectrum, which is absorbed or emitted with high intensity. It is defined as a local maximum in the spectrum.</obo:IAO_0000115>
        <obo:coarseClassification>information content entity</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <obo:refersToCompetenceQuestion>IFNANO:01_CQ</obo:refersToCompetenceQuestion>
        <dc:contributor>Sven Schwabe (IFNANO)</dc:contributor>
        <pav:lastUpdateOn>06.06.2023</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">31.03.2022</oboInOwl:creation_date>
        <rdfs:comment>in Spectroscopy</rdfs:comment>
        <rdfs:label xml:lang="en">peak [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">Unprocessed data obtained from spectrometric devices</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Rohspektrum</obo:IAO_0000118>
        <obo:coarseClassification>information content entity</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <obo:refersToCompetenceQuestion>IFNANO:01_CQ</obo:refersToCompetenceQuestion>
        <dc:contributor>Sven Schwabe (IFNANO)</dc:contributor>
