        <rdfs:label xml:lang="en">normalization [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000642 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000290"/>
        <obo:IAO_0000115 xml:lang="en">Polybutadiene [butadiene rubber BR] is a synthetic rubber. Polybutadiene rubber is a polymer formed from the polymerization of the monomer 1,3-butadiene. Polybutadiene has a high resistance to wear and is used especially in the manufacture of tires.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Yamen Alsalka</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">06.06.2023</pav:lastUpdateOn>
        <oboInOwl:created_by>Yamen Alsalka</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-06-06T10:51:28.399079Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">butadiene rubber BR [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000643 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000643">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">An atom or group of atoms within a molecule that has similar chemical properties whenever it appears in various compounds. Even if other parts of the molecule are quite different, certain functional groups tend to react in certain ways.</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:resource="https://chem.libretexts.org/Courses/University_of_Kentucky/UK%3A_CHE_103_-_Chemistry_for_Allied_Health_(Soult)/Chapters/Chapter_4%3A_Structure_and_Function/4.4%3A_Functional_Groups#:~:text=A%20functional%20group%20is%20defined,to%20react%20in%20certain%20ways."/>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Yamen Alsalka</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">06.06.2023</pav:lastUpdateOn>
        <oboInOwl:created_by>Yamen Alsalka</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-06-06T10:12:52.940172Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">functional group [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000644 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000644">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000290"/>
        <obo:IAO_0000115 xml:lang="en">Is a synthetic rubber, a copolymer of isobutylene with isoprene</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Yamen Alsalka</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">06.06.2023</pav:lastUpdateOn>
        <oboInOwl:created_by>Yamen Alsalka</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-06-06T12:23:10.166673Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">butyl rubber BIIR [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000645 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000645">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000290"/>
        <obo:IAO_0000115 xml:lang="en">EPDM rubber (ethylene propylene diene monomer rubber) is a type of synthetic rubber that is composed of ethylidene norbornene (ENB), dicyclopentadiene (DCPD), and vinyl norbornene (VNB).</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Yamen Alsalka</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">06.06.2023</pav:lastUpdateOn>
        <oboInOwl:created_by>Yamen Alsalka</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-06-06T12:27:10.818157Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">EPDM rubber [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000646 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000290"/>
        <obo:IAO_0000115 xml:lang="en">A synthetic cis-1,4-polyisoprene, made by the industrial polymerisation of isoprene.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Yamen Alsalka</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">06.06.2023</pav:lastUpdateOn>
        <oboInOwl:created_by>Yamen Alsalka</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-06-06T12:30:53.148584Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">polyisoprene IR [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000647 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000290"/>
        <obo:IAO_0000115 xml:lang="en">Known as nitrile butadiene rubber and acrylonitrile butadiene rubber, is a synthetic rubber derived from acrylonitrile (ACN) and butadiene.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Yamen Alsalka</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">06.06.2023</pav:lastUpdateOn>
        <oboInOwl:created_by>Yamen Alsalka</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-06-06T12:33:41.882181Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">nitrile rubber NBR [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000648 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28798"/>
        <obo:IAO_0000115 xml:lang="en">Is a family of fluorocarbon-based fluoroelastomer materials that contain vinylidene fluoride as a monomer.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Yamen Alsalka</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">06.06.2023</pav:lastUpdateOn>
        <oboInOwl:created_by>Yamen Alsalka</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-06-06T12:36:21.319884Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">fluororubber FKM [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000649 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000649">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28798"/>
        <obo:IAO_0000115 xml:lang="en">Highly Saturated Nitrile. A Higher performance solid rubber material than NBR, achieved through adding Hydrogen Atoms to the Butadiene Segments.</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:resource="https://maclellanrubber.com/definitions/hnbr"/>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Yamen Alsalka</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">06.06.2023</pav:lastUpdateOn>
        <oboInOwl:created_by>Yamen Alsalka</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-06-06T12:40:53.184235Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">hydrogenated nitrile rubber HNBR [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000650 -->

