        <obo:IAO_0000115 xml:lang="en">Families of synthetic rubbers derived from styrene and butadiene.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia</obo:IAO_0000119>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
