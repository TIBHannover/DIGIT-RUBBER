        <rdfs:comment xml:lang="en">Pins improve material homogenization and facilitate polymer transport within the extruder.</rdfs:comment>
        <rdfs:label xml:lang="de">Extruderstift</rdfs:label>
        <rdfs:label xml:lang="en">extruder pin</rdfs:label>
    </owl:Class>
    


