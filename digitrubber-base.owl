        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">10.05.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">Mooney shearing-disc viscometer [dik]</rdfs:label>
        <rdfs:label xml:lang="de">Mooney-Scherscheibenviskosimeter [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000582 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000582">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:coarseClassification>device</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">21.05.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">21.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Rheometer [dik]</rdfs:label>
        <rdfs:label xml:lang="en">curemeter [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000583 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000582"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Rheometertyp, bei welchem die auf die Kautschukmischung einwirkenden Kräfte durch eine in der Testprobe eingebettete schwingende Scheibe erzeugt werden, wobei sich die Probe unter Druck in einem abgedichteten Probenaufnehmer befindet</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">type of curemeter in which the force applied to the rubber compound is produced by an oscillating disc embedded in a test sample which is contained under pressure in a sealed cavity</obo:IAO_0000115>
        <obo:coarseClassification>device</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">10.05.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">oscillating-disc curemeter [dik]</rdfs:label>
        <rdfs:label xml:lang="de">oszillierendes Scheibenrheometer [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000582"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Typ eines Rheometers, bei welchem die Kraft, die auf die Kautschukmischung einwirkt, durch die Oszillation einer von zwei Platten erzeugt wird, die die Kammer bilden, in welcher die Testprobe eingeschlossen ist</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">type of curemeter in which the force applied to the rubber compound is produced by the oscillation of one of the two dies forming the cavity in which the test sample is enclosed</obo:IAO_0000115>
        <obo:coarseClassification>device</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <terms:identifier>DIN ISO 1382:2016-07</terms:identifier>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">10.05.2022</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">rotorless curemeter [dik]</rdfs:label>
        <rdfs:label xml:lang="de">rotorloser Rheometer [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000585 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000585">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Gerät zur Messung des Fortschritts der Vulkanisation in einer Probe bei der Vulkanisationsstemperatur</obo:IAO_0000115>
