        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">31.03.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">raw spectrum [ifnano]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
