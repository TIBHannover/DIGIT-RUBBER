        <rdfs:label xml:lang="de">Prüfprozess</rdfs:label>
        <rdfs:label xml:lang="en">assay process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000506">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001025"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">An assay with the objective to produce information about the density of the material entity that is the evaluant, by physically examining it or its proxies.</obo:IAO_0000115>
        <obo:coarseClassification>assay</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Prüfung zur Dichtemessung [dik]</rdfs:label>
        <rdfs:label xml:lang="en">density measurement assay [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000515 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000515">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001025"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">An assay with the objective to produce information about the viscosity of the material entity that is the evaluant, by physically examining it or its proxies.</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
