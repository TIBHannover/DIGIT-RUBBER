    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER1000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER1000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A site that is a designated region within a technical device where a specific function of the device is realized.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Modelled as a subclass of Site because industrial &apos;zones&apos; are typically functional subdivisions rather than physically separated parts.</obo:IAO_0000116>
        <obo:IAO_0000118 xml:lang="en">device section</obo:IAO_0000118>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8280-0487"/>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">24.09.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">24.09.2025</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Examples include feeding zone, compression zone, pin zone, and metering zone of an extruder.</rdfs:comment>
        <rdfs:label xml:lang="de">Gerätezone</rdfs:label>
        <rdfs:label xml:lang="en">device zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER1000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER1000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER1000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000424"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A device zone that is part of an extruder and in which a sub-process of extrusion occurs.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">extruder section</obo:IAO_0000118>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8280-0487"/>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">24.09.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">24.09.2025</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Examples include feeding zone, compression zone, pin zone, and metering zone of an extruder.</rdfs:comment>
        <rdfs:label xml:lang="de">Extruderzone</rdfs:label>
        <rdfs:label xml:lang="en">extruder zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">In relation to optical measuring methods, a rating for the precision of a reconstructed measurement object.</obo:IAO_0000115>
        <obo:coarseClassification>quality</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
