        <rdfs:label xml:lang="de">Schmelzbereich‎ [dik]</rdfs:label>
        <rdfs:label xml:lang="en">melting range [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000571 -->

