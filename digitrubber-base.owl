    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000281 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115 xml:lang="en">Group of interlocked aggregates that are easily separated by normal rubber processing</obo:IAO_0000115>
