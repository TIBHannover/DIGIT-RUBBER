    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">The standard deviation is a measure of the amount of variation or dispersion of a set of values. [Wikipedia]</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.allotrope.org/ontologies/result#AFR_0002192</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.allotrope.org/"/>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
