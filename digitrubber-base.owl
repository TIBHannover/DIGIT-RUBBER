        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">21.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Viskosimeter [dik]</rdfs:label>
        <rdfs:label xml:lang="en">viscometer [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000581 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000581">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000118 xml:lang="de">Mooney-Viskosimeter</obo:IAO_0000118>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
