    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000371 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Process of converting a rubber or rubber mix, rubber dough or coagulated latex into a form in which the thickness is small in proportion to the length</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="de">Prozess der Überführung von Kautschuk oder einer Kautschukmischung, Gummilösung oder koaguliertem Latex in eine Form, bei der die Dicke klein gegenüber der Länge ist</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Plattenziehen</obo:IAO_0000118>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
