        <rdfs:label xml:lang="en">ring test</rdfs:label>
        <rdfs:label xml:lang="de">ringversuch</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000086 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">surface topography is the variations in the surface characteristics of a polymer mixture which influences the resulting properties of the end product.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
