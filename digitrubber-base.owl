        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Penetration thermometer is a device which is used to measure the temperature of materials.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
