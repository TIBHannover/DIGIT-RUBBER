        <rdfs:label xml:lang="de">Prüfung zur Viskositätsmessung [dik]</rdfs:label>
        <rdfs:label xml:lang="en">viscosity measurement assay [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000516 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000516">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001025"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">An assay with the objective to produce information about the Mooney viscosity of the material entity that is the evaluant, by physically examining it or its proxies.</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn>13.02.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">10.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">Mooney viscosity measurement assay [dik]</rdfs:label>
        <rdfs:label xml:lang="de">Prüfung zur Mooney-Viskositätsmessung [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000520 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000520">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="de">Maß für die Viskosität eines Rohkautschuks oder einer Kautschukmischung, bestimmt mit einem Mooney-Scherscheibenviskosimeter</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">measure of the viscosity of a raw rubber or rubber compound, determined using a Mooney shearing-disc viscometer</obo:IAO_0000115>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor>Alexander Aschemann</dc:contributor>
