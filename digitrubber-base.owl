        <obo:IAO_0000115 xml:lang="en">An active power or cause (as principle, substance, physical or biological factor, etc.) that produces a specific effect.</obo:IAO_0000115>
        <obo:IAO_0000119>http://purl.obolibrary.org/obo/NCIT_C1708</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:coarseClassification>role</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
