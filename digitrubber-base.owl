        <obo:IAO_0000115 xml:lang="en">The ratio of the dynamic viscosity (μ) over the density of the fluid (ρ), which is noted as (length)^2/time. https://en.wikipedia.org/wiki/Viscosity#Kinematic_viscosity</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/UO_01200023"/>
