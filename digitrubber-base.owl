    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">Material that is used to support the structure of rubber-based products (e.g., steel cords). Constitutes an entity subgroup of the raw material entity.</obo:IAO_0000115>
        <obo:coarseClassification>material entity</obo:coarseClassification>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</obo:preliminary_broad_class_assigned>
