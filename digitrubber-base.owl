    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Mixing time reduction in polymers refers to the process of optimizing the mixing sequence and parameters to achieve batch-to-batch uniformity, fast reduction of viscosity, and efficient use of time, power, and equipment for optimum productivity.</obo:IAO_0000115>
