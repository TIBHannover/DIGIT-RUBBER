        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">31.3.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">natural rubber [hsh]</rdfs:label>
        <rdfs:label xml:lang="de">naturkautschuk [hsh]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000179 -->

