    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000461 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER1000031"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">An extruder zone equipped with pins that enhance mixing and shearing of the material during extrusion.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">mixing pin section</obo:IAO_0000118>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-8280-0487"/>
        <dc:contributor>Alexander Aschemann</dc:contributor>
        <dc:language>English</dc:language>
        <pav:lastUpdateOn>24.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">21.05.2022</oboInOwl:creation_date>
        <rdfs:comment xml:lang="en">Pins protruding into the extruder channel increase material mixing, cooling, and homogenization.</rdfs:comment>
        <rdfs:label xml:lang="de">Stiftzone</rdfs:label>
        <rdfs:label xml:lang="en">pin zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000462">
