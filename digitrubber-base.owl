        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">equation in the context of chemistry is a symbolic representation of the changes which occur in a chemical reaction, expressed in terms of the formulae of the molecules or other species involved.</obo:IAO_0000115>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">02.02.2026</pav:lastUpdateOn>
