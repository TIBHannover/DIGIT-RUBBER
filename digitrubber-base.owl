        <obo:IAO_0000700 rdf:resource="http://www.purl.org/OntoMeta/DigitRubber#1"/>
        <dc:creator rdf:resource="http://purl.obolibrary.org/obo/digitrubber/digitrubber-full.owl#DIGIT_RUBBER_project"/>
        <dc:creator rdf:resource="http://purl.obolibrary.org/obo/digitrubber/digitrubber-full.owl#DIPONI_project"/>
        <dc:creator rdf:resource="http://purl.obolibrary.org/obo/digitrubber/digitrubber-full.owl#InSuKa_project"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-01T00:00:00</dc:date>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/IAO_8000001"/>
        <terms:bibliographicCitation xml:lang="en">TIB (2023): DigitRubber Ontology. An ontology demonstrating rich ontology for rubber extrusion. PURL: http://www.purl.org/OntoMeta/DigitRubberOntology.</terms:bibliographicCitation>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-8280-0487"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-01T00:00:00</terms:created>
        <terms:description xml:lang="en">DigitRubber Ontology</terms:description>
        <terms:description>The DIGIT RUBBER Ontology (DRO) is used to represent data, information, and knowledge relating to rubber and rubber production.</terms:description>
        <terms:format rdf:resource="https://www.iana.org/assignments/media-types/application/rdf+xml"/>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified>2025-09-25T00:00:00</terms:modified>
        <terms:references rdf:resource="https://zenodo.org/record/0000000"/>
        <terms:subject rdf:resource="https://purl.org/linsearch/fer"/>
        <terms:title xml:lang="en">DigitRubber Ontology</terms:title>
        <bibo:status xml:lang="en">active</bibo:status>
        <pav:derivedFrom rdf:resource="http://www.purl.org/DigitRubberOntology/0.0.1"/>
        <vann:preferredNamespacePrefix>DRO</vann:preferredNamespacePrefix>
        <schema:funder rdf:resource="https://ror.org/"/>
        <schema:inLanguage rdf:resource="https://id.loc.gov/vocabulary/iso639-2/eng"/>
        <doap:audience xml:lang="en">The DIGIT RUBBER ontology is aimed at anyone who wants to semantically annotate knowledge and data related to rubber.</doap:audience>
        <doap:bug-database rdf:resource="https://github.com/TIBHannover/DIGIT-RUBBER/issues"/>
        <doap:repository rdf:resource="https://github.com/TIBHannover/DIGIT-RUBBER"/>
        <oboInOwl:date>13:03:2026 09:03</oboInOwl:date>
        <v3:documentation rdf:resource="https://tibhannover.github.io/DIGIT-RUBBER/"/>
        <owl:versionInfo>v2025-September-25</owl:versionInfo>
        <owl:versionInfo>2026-03-13</owl:versionInfo>
        <adms:versionNotes xml:lang="en">A description of changes between last version and current version of the ontology.</adms:versionNotes>
        <dcat:distribution rdf:resource="http://www.purl.org/OntoMeta/DigitRubber.owl"/>
        <vann2:example rdf:resource="http://www.purl.org/OntoMeta/DigitRubber/docs/descriptionOfUse"/>
        <mod:acronym>DRO</mod:acronym>
        <mod:competencyQuestion rdf:resource="https://github.com/TIBHannover/DIGIT-RUBBER/tree/main/preliminary_data/Competeny%20Questions"/>
        <mod:hasFormalityLevel xml:lang="en">The DigitRubber ontology aplies OWL2 EL (cf. https://www.w3.org/TR/2012/REC-owl2-profiles-20121211/#OWL_2_EL)</mod:hasFormalityLevel>
    </owl:Ontology>
    


