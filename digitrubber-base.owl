        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">31.3.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">measurement quality [imr]</rdfs:label>
    </owl:Class>
    


