    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_1000005"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Rubber polymer with styrene and butadiene as monomers. It is the major component of tread compounds.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">SBR</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">15.1.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">styrene-butadiene rubber [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000003"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Polymerization is performed in an emulsion where polymer particles (and consequently, crumbs) are carried in a liquid (water) medium.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">ESBR</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">15.1.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">emulsion SBR [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000003"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Polymerization is performed in a solution where polymer molecules are dissolved in a solvent (e.g. hexane).</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">SSBR</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">15.1.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">solution SBR [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60004"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Compound that has not been vulcanized and may be heated in an oven to form of network.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">GC</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">green compound [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60004"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Compound after being vulcanized. May also be called “vulcanizate”.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">VC</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">vulcanized compound [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The process of converting a polymer compound into an elastic network using vulcanization chemicals (e.g. sulfur) and heat (to start the reaction).</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">vulcanization [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Fraction of rubber compound formulations are not given based on %, so that the sum of all components will be 100%.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">phr</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">parts per hundred rubber [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Solid particles added to compound to generate enforcement.</obo:IAO_0000115>
        <pav:lastUpdateOn xml:lang="en">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">filler [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_1000013"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A filler based on structured carbon which is present in larger fractions in sidewall than in tread compounds. Every CB grade has two major properties that determine its properties.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">CB</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">carbon black [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_1000013"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A filler that, together with silane, is present only in tread compounds and is used for enforcement.</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">silica [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Silane is necessary to act as intermediary between silica and the SBR matrix, and its role is to enhance the dispersion of silica in the SBR matrix.</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">silane [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DIGITRUBBER_000441"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The outer surface of a tire that comes into direct contact with the road.</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">tread [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The lining of the inner wall of a tire which prevents air from escaping.</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">inner liner [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000019">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The component of modulus that is related to energy storage in deformation.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">G&apos;</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">elastic modulus [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">The component of modulus that is related to energy loss in deformation.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">G&apos;&apos;</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">loss modulus [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Mooney Viscosity is a quality of raw and vulcanised polymersbased on the measurement of the torque necessary to rotate a disc in a cylindrical chamber filled with the rubber compound to be vulcanized and is reported in arbitrary Mooney units. It is the torque at t=5 min. after the start of the Mooney test for vulcanized polymers.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">ML1+4</obo:IAO_0000118>
        <obo:IAO_0000118>Mooney Viscosity</obo:IAO_0000118>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.11.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">mooney viscosity [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Mooney stress relaxation is a quality of polymer that refers to the time-dependent process of relaxing a stress applied to a polymer. Due to their structure, polymers do not easily “forget” stress after it is applied to them.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">MSR</obo:IAO_0000118>
        <pav:lastUpdateOn xml:lang="en">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">mooney stress relaxation [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Generic name for an instrument that applies amplitude sweeps to vulcanized rubber to assess the resistance of its network against large deformations.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">MTS</obo:IAO_0000118>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">mechanical testing system [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Generic name for an instrument that applies oscillatory shearing deformation at the vulcanization temperature of a compound at a given time window, using a constant frequency and amplitude.</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">moving die rheometer [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000003"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A method in which the polymer is loaded with (pseudo-) linear, oscillating deformations in a temperature ramp, during which the values of G’ and G” at 3 critical temperatures are read and used .</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">dynamic mechanical thermal analysis [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">In physical testing, it refers to a constant increase or decrease of testing parameters such as deformation frequency, deformation amplitude or temperature.</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">ramp [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">In physical testing, it refers to a deformation regime in which layers of fluid or solid are forced to move parallel to each other.</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">shearing [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000028">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">In physical testing, it refers to a deformation regime in which layers of fluid or solid deformed axially.</obo:IAO_0000115>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.9.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">elongation [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Styrene content is a quality that is a key factor in determining the properties of polymers derived from styrene.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Styrene Content</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">Styrene_Cont</obo:IAO_0000118>
        <dc:contributor>Pallavi Karanth</dc:contributor>
        <dc:language xml:lang="en">English</dc:language>
        <pav:lastUpdateOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.11.2026</pav:lastUpdateOn>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">19.11.2025</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">styrene content [Arlanxeo]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_1000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_1000032">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">Cis content is a quality in polymers, particularly in polyisoprene, that is crucial for determining the material&apos;s properties based on the content of cis isomer which is known for its high elasticity and tensile strength.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="en">Cis Content</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="en">Cis_Cont</obo:IAO_0000118>
