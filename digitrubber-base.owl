        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">31.3.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">synthetic rubber [hsh]</rdfs:label>
        <rdfs:label xml:lang="de">synthetikkautschuk [hsh]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <obo:IAO_0000115 xml:lang="en">Material that is required to manipulate the properties of rubber products. Constitutes an entity sub-group of the raw material entity.</obo:IAO_0000115>
