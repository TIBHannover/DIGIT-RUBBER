    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000504 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000124"/>
        <obo:IAO_0000115 xml:lang="en">A qualitative or quantitative analysis performed to determine the amount of a particular constituent in a sample or the biological or pharmacological properties of a drug.</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/NCIT_C60819"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
