    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">Scaling spectra in order to get all data on approximately the same scale.</obo:IAO_0000115>
        <obo:IAO_0000119>Unscrambler X</obo:IAO_0000119>
        <obo:preliminary_broad_class_assigned rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</obo:preliminary_broad_class_assigned>
