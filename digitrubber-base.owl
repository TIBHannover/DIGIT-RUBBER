        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#Date">03.05.2022</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Mooney Viskosität [dik]</rdfs:label>
        <rdfs:label xml:lang="en">Mooney viscosity [dik]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DIGITRUBBER_000523">
