        <pav:lastUpdateOn>01.01.2024</pav:lastUpdateOn>
        <oboInOwl:creation_date>01.01.2024</oboInOwl:creation_date>
        <rdfs:label xml:lang="de">Kalandar [hsh]</rdfs:label>
        <rdfs:label xml:lang="en">calandar [hsh]</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DIGITRUBBER_000171 -->

